# RM Investor — Streamlit Secrets template
# ---------------------------------------------------------------------------
# COPY this file's contents into the Streamlit Community Cloud dashboard:
#   App  ->  Settings  ->  Secrets   (paste, then Save)
# Do NOT commit the real .streamlit/secrets.toml — it is gitignored.
#
# For local testing you may instead create .streamlit/secrets.toml with the
# same keys, but locally the app already reads .env and holdings.csv, so you
# usually don't need to.
# ---------------------------------------------------------------------------

# Gate the public app to just you + your friend. If unset, the app is OPEN.
APP_PASSWORD = "change-me-to-something-long"

# API keys (same names as .env). Only set the ones your plan uses.
FMP_API_KEY = ""
FINNHUB_API_KEY = ""
ALPHAVANTAGE_API_KEY = ""
SEC_USER_AGENT = "RM Investor research your-email@example.com"

# Your REAL portfolio, inline. This never lives in the repo — only here, in
# Streamlit's encrypted secrets. Same columns as holdings.csv. Keep the triple
# quotes; the header row is required. (Rows below are fake placeholders.)
HOLDINGS_CSV = """
ticker,shares,cost_basis
EXMPL,100.0,12.34
DEMO,50.0,7.89
"""
