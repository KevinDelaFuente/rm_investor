# RM Investor — free-tier defaults. Copy to .env and fill in keys as you obtain them.
# Everything runs on yfinance (no key) out of the box; these unlock extra sources.

# Finnhub free tier — analyst ratings/targets + company news. https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage free key — fundamentals + NEWS_SENTIMENT (rate-limited: ~25 req/day).
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Quiver Quantitative — congressional (politician) trades. Free/paid tiers.
# https://www.quiverquant.com/  (create an account -> API key)
QUIVER_API_KEY=

# Financial Modeling Prep — congress trades, analyst ratings/targets, news, fundamentals.
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# SEC EDGAR requires a descriptive User-Agent (name + email) per their fair-access policy.
SEC_USER_AGENT=RM Investor research your-email@example.com
